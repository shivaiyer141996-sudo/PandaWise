NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
ALLOWED_ORIGINS=*

# Use memory for local development/tests. Production uses google-sheets.
DATA_PROVIDER=memory

# Required when DATA_PROVIDER=google-sheets.
GOOGLE_SHEET_ID=1ox11C3hz0pozmjM3bwk6vh99OHH4HPxknSD0tejJRDY
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_MAX_ATTEMPTS=3
GOOGLE_SHEETS_RETRY_BASE_MS=200

# Use at least 32 random characters outside local development.
JWT_SECRET=replace-this-development-secret-with-32-characters
JWT_EXPIRES_IN=8h
